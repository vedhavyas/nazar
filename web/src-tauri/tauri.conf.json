{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nazar",
  "identifier": "dev.vedhavyas.nazar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nazar",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDQUNDRkYyOTFDMEEwRDcKUldUWG9NQ1I4cytzakJiYnJkMGVjaERQV0RrRXNvNjZxcWdOd3M5dXFzVEpaNjVnSUZMR0E2c2wK",
      "endpoints": [
        "https://github.com/vedhavyas/nazar-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
